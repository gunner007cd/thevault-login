EOF_THEVAULT_LOGIN_IMAGE

chmod 0644 "$PLUGDIR/login.css" "$PLUGDIR/background.webp" "$PLUGDIR/README.md"

/usr/bin/php <<'PHP_THEVAULT_INSTALL'
<?php
$cssPath = '/usr/local/emhttp/plugins/thevault.login/login.css';
$imgPath = '/usr/local/emhttp/plugins/thevault.login/background.webp';
$targets = [
    '/usr/local/emhttp/webGui/include/.login.php',
    '/usr/local/emhttp/plugins/dynamix/include/.login.php',
];

$css = @file_get_contents($cssPath);
$img = @file_get_contents($imgPath);
if ($css === false || $img === false) {
    fwrite(STDERR, "TheVault Login: unable to read embedded CSS or image.\n");
    exit(1);
}

$ver = 'unknown';
$ini = @parse_ini_file('/etc/unraid-version');
if (is_array($ini) && !empty($ini['version'])) {
    $ver = (string)$ini['version'];
}

$css = str_replace(
    '__THEVAULT_BACKGROUND__',
    'data:image/webp;base64,' . base64_encode($img),
    $css
);

$block = "\n<style id=\"thevault-login-style\">\n" . $css . "\n</style>\n";
$verHtml = htmlspecialchars($ver, ENT_QUOTES, 'UTF-8');
$versionBlock = "\n            <div id=\"thevault-login-version\">UNRAID {$verHtml}</div>\n";
$patched = 0;

foreach ($targets as $path) {
    if (!is_file($path)) {
        continue;
    }

    $text = @file_get_contents($path);
    if ($text === false) {
        continue;
    }

    // Guard against blindly altering an unrelated future login implementation.
    if (strpos($text, '<section id="login" class="shadow">') === false ||
        strpos($text, '<form action="/login" method="POST">') === false ||
        strpos($text, '</head>') === false) {
        continue;
    }

    // Upgrade-safe/idempotent cleanup from v2026.10.19a and repeated installs.
    $text = preg_replace(
        '#\s*<link[^>]+(?:thevault\.login|thevault-login)[^>]*>\s*#i',
        "\n",
        $text
    );
    $text = preg_replace(
        '#\s*<style id="thevault-login-style">.*?</style>\s*#s',
        "\n",
        $text
    );
    $text = preg_replace(
        '#\s*<style id="thevault-login-version-style">.*?</style>\s*#s',
        "\n",
        $text
    );
    $text = preg_replace(
        '#\s*<div id="thevault-login-version">.*?</div>\s*#s',
        "\n",
        $text
    );

    $text = preg_replace('#</head>#', $block . '</head>', $text, 1, $headCount);
    $text = preg_replace(
        '#(<a href="https://docs\.unraid\.net/go/lost-root-password/" target="_blank">.*?</a>)#s',
        '$1' . $versionBlock,
        $text,
        1,
        $versionCount
    );

    if ($headCount === 1 && $versionCount === 1 && @file_put_contents($path, $text) !== false) {
        $patched++;
    }
}

if ($patched < 1) {
    fwrite(STDERR, "TheVault Login: compatible Unraid login template not found; stock login left untouched.\n");
    exit(0);
}

echo "TheVault Login: inline split theme + real version footer applied to $patched template(s); Unraid $ver.\n";
?>
PHP_THEVAULT_INSTALL

logger -t thevault-login "TheVault inline split login theme with version footer applied"
echo "TheVault Login $VERSION installed."
echo "Open /login in a private window to preview it."
]]></INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE><![CDATA[
#!/bin/bash
set -eu

NAME="thevault.login"
PLUGDIR="/usr/local/emhttp/plugins/$NAME"

/usr/bin/php <<'PHP_THEVAULT_REMOVE'
<?php
$targets = [
    '/usr/local/emhttp/webGui/include/.login.php',
    '/usr/local/emhttp/plugins/dynamix/include/.login.php',
];

foreach ($targets as $path) {
    if (!is_file($path)) continue;
    $text = @file_get_contents($path);
    if ($text === false) continue;

    $text = preg_replace(
        '#\s*<link[^>]+(?:thevault\.login|thevault-login)[^>]*>\s*#i',
        "\n",
        $text
    );
    $text = preg_replace(
        '#\s*<style id="thevault-login-style">.*?</style>\s*#s',
        "\n",
        $text
    );
    $text = preg_replace(
        '#\s*<style id="thevault-login-version-style">.*?</style>\s*#s',
        "\n",
        $text
    );
    $text = preg_replace(
        '#\s*<div id="thevault-login-version">.*?</div>\s*#s',
        "\n",
        $text
    );
    @file_put_contents($path, $text);
}
?>
PHP_THEVAULT_REMOVE

rm -rf "$PLUGDIR"
logger -t thevault-login "TheVault split login theme removed"
echo "TheVault Login removed; stock login styling restored."
]]></INLINE>
</FILE>

</PLUGIN>
